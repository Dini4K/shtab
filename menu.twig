<div class="col-sm-3">
  <div class="list-group">
    {% for key, item in menu %}
    <a href="{{ item.href }}" class="list-group-item {% if item.active %}active{% endif %}">
      <i class="fa {{ item.icon }}"></i> {{ item.name }}
      {% if item.children %}
      <span class="pull-right"><i class="fa fa-angle-down"></i></span>
      {% endif %}
    </a>
    {% if item.children and item.active %}
      {% for child in item.children %}
      <a href="{{ child.href }}" class="list-group-item small" style="padding-left: 30px;">
        <i class="fa fa-angle-right"></i> {{ child.name }}
      </a>
      {% endfor %}
    {% endif %}
    {% endfor %}
  </div>
</div>