{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="btn-save" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>

  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-cogs"></i> {{ text_settings }}</h3>
      </div>
      <div class="panel-body">
        {{ menu }}
        
        <form id="form-settings">
          <div class="tab-content">
            <div class="tab-pane active" id="tab-redis">
              <fieldset>
                <legend>{{ text_redis }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-redis-host">{{ entry_redis_host }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="shtab_redis_host" value="{{ settings.shtab_redis_host }}" placeholder="127.0.0.1" id="input-redis-host" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-redis-port">{{ entry_redis_port }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="shtab_redis_port" value="{{ settings.shtab_redis_port }}" placeholder="6379" id="input-redis-port" class="form-control" />
                  </div>
                </div>
              </fieldset>
            </div>
            
            <div class="tab-pane" id="tab-telegram">
              <fieldset>
                <legend>{{ text_telegram }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-telegram-token">{{ entry_telegram_bot_token }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="shtab_telegram_bot_token" value="{{ settings.shtab_telegram_bot_token }}" placeholder="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11" id="input-telegram-token" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-telegram-chat">{{ entry_telegram_chat_id }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="shtab_telegram_chat_id" value="{{ settings.shtab_telegram_chat_id }}" placeholder="-1001234567890" id="input-telegram-chat" class="form-control" />
                  </div>
                </div>
              </fieldset>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
$('#btn-save').on('click', function() {
    $.ajax({
        url: '{{ action }}',
        type: 'post',
        data: $('#form-settings').serialize(),
        dataType: 'json',
        beforeSend: function() {
            $('#btn-save').button('loading');
        },
        complete: function() {
            $('#btn-save').button('reset');
        },
        success: function(json) {
            if (json['success']) {
                alert('Настройки сохранены!');
            } else if (json['error']) {
                alert(json['error']);
            }
        }
    });
});
</script>
{{ footer }}