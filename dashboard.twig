{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="btn-run-manual" class="btn btn-success"><i class="fa fa-play"></i> Запустить вручную</button>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>

  <div class="container-fluid">
    {{ menu }}
    
    <!-- Статистика -->
    <div class="row">
      <div class="col-lg-3 col-md-6">
        <div class="panel panel-primary">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-cogs"></i> Активные правила</h3>
          </div>
          <div class="panel-body">
            <h2>{{ stats.active_rules }}</h2>
            <p>Правил активно</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6">
        <div class="panel panel-green">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-tasks"></i> CRON задачи</h3>
          </div>
          <div class="panel-body">
            <h2>{{ stats.active_tasks }}</h2>
            <p>Активных задач</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6">
        <div class="panel panel-yellow">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-history"></i> Изменения за день</h3>
          </div>
          <div class="panel-body">
            <h2>{{ stats.today_changes }}</h2>
            <p>Изменений цен</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6">
        <div class="panel panel-red">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Ошибки</h3>
          </div>
          <div class="panel-body">
            <h2>{{ stats.last_errors }}</h2>
            <p>За последнюю неделю</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Быстрые действия -->
    <div class="row">
      <div class="col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-rocket"></i> Быстрые действия</h3>
          </div>
          <div class="panel-body">
            <div class="btn-group">
              <a href="{{ add_rule_url }}" class="btn btn-primary"><i class="fa fa-plus"></i> Создать правило</a>
              <a href="{{ tasks_url }}" class="btn btn-info"><i class="fa fa-clock"></i> Настроить CRON</a>
              <a href="{{ history_url }}" class="btn btn-warning"><i class="fa fa-history"></i> История изменений</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$('#btn-run-manual').on('click', function() {
    if (!confirm('Запустить репрайсинг для всех товаров?')) return;
    
    $.ajax({
        url: 'index.php?route=extension/module/shtab/repricing/runManual&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        beforeSend: function() {
            $('#btn-run-manual').button('loading');
        },
        complete: function() {
            $('#btn-run-manual').button('reset');
        },
        success: function(json) {
            if (json.success) {
                alert('Репрайсинг завершен! Обработано: ' + json.processed + ' товаров, изменений: ' + json.changes);
            } else {
                alert('Ошибка: ' + json.error);
            }
        }
    });
});
</script>
{{ footer }}