{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
    </div>
  </div>

  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        {{ menu }}
        
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-center">{{ column_product_id }}</td>
                <td>{{ column_name }}</td>
                <td>{{ column_cost_price }}</td>
                <td>{{ column_min_price }}</td>
                <td>{{ column_max_price }}</td>
                <td>{{ column_rrp_price }}</td>
                <td>{{ column_marketplace }}</td>
                <td>{{ column_marketplace_price }}</td>
                <td>{{ column_status }}</td>
                <td>{{ column_action }}</td>
              </tr>
            </thead>
            <tbody>
              {% for product in products %}
              <tr>
                <td class="text-center">{{ product.product_id }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.cost_price }}</td>
                <td>{{ product.min_price }}</td>
                <td>{{ product.max_price }}</td>
                <td>{{ product.rrp_price }}</td>
                <td>{{ product.marketplace }}</td>
                <td>{{ product.marketplace_price }}</td>
                <td>
                  {% if product.repricing_enabled %}
                  <span class="label label-success">{{ text_repricing_enabled }}</span>
                  {% else %}
                  <span class="label label-danger">{{ text_repricing_disabled }}</span>
                  {% endif %}
                </td>
                <td>
                  <button type="button" data-product-id="{{ product.product_id }}" class="btn btn-primary btn-edit" data-toggle="tooltip" title="{{ button_edit }}">
                    <i class="fa fa-pencil"></i>
                  </button>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$('.btn-edit').on('click', function() {
    var product_id = $(this).data('product-id');
    // Здесь будет модальное окно редактирования
    alert('Редактирование товара ID: ' + product_id);
});
</script>
{{ footer }}